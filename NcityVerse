<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Neo-Zone 💚 | Markas NCTzen Paling Seru</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans & Space Grotesk -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            display: ['"Space Grotesk"', 'sans-serif'],
          },
          colors: {
            neo: {
              green: '#B2E800',
              bright: '#39FF14',
              dark: '#0A0A0C',
              card: '#131318',
              border: '#24242E',
              u127: '#FF3B30',
              dream: '#00E5FF',
              wayv: '#FF2E93',
              wish: '#A855F7'
            }
          },
          animation: {
            'float': 'float 4s ease-in-out infinite',
            'pulse-glow': 'pulseGlow 2.5s infinite',
            'spin-slow': 'spin 12s linear infinite',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-10px)' },
            },
            pulseGlow: {
              '0%, 100%': { boxShadow: '0 0 15px rgba(178, 232, 0, 0.35)' },
              '50%': { boxShadow: '0 0 30px rgba(57, 255, 20, 0.7)' },
            }
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #0A0A0C;
      color: #FFFFFF;
      overflow-x: hidden;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #0A0A0C;
    }
    ::-webkit-scrollbar-thumb {
      background: #24242E;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #B2E800;
    }

    /* Neon Grid Background */
    .neo-grid-bg {
      background-size: 40px 40px;
      background-image: 
        linear-gradient(to right, rgba(178, 232, 0, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(178, 232, 0, 0.05) 1px, transparent 1px);
    }

    .text-glow {
      text-shadow: 0 0 20px rgba(178, 232, 0, 0.45);
    }

    .glass-panel {
      background: rgba(19, 19, 24, 0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(178, 232, 0, 0.16);
    }

    /* Confetti particle animation */
    @keyframes confettiFall {
      0% { transform: translateY(-20px) rotate(0deg) scale(1); opacity: 1; }
      100% { transform: translateY(100vh) rotate(720deg) scale(0.5); opacity: 0; }
    }
    .confetti-piece {
      position: fixed;
      top: -10px;
      z-index: 9999;
      pointer-events: none;
      animation: confettiFall linear forwards;
    }
  </style>
</head>
<body class="neo-grid-bg antialiased selection:bg-neo-green selection:text-neo-dark">

  <!-- Toast Notification Container (Easter Egg & Feedback) -->
  <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-3 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- ================= NAVBAR ================= -->
  <header class="sticky top-0 z-40 glass-panel border-b border-neo-border/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 py-3 flex items-center justify-between gap-2">
      <!-- Logo (Easter Egg Trigger) -->
      <button onclick="triggerEasterEgg()" title="Klik untuk kejutan NCT!" class="group flex items-center gap-3 text-left focus:outline-none rounded-2xl p-1.5 hover:bg-white/5 transition">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-neo-green to-neo-bright text-neo-dark flex items-center justify-center font-display font-extrabold text-lg shadow-lg shadow-neo-green/30 group-hover:scale-110 group-hover:rotate-6 transition-transform">
          NCT
        </div>
        <div>
          <span class="font-display font-extrabold text-lg sm:text-xl tracking-tight text-white flex items-center gap-1.5">
            NEO-ZONE <span class="inline-block w-2 h-2 rounded-full bg-neo-bright animate-ping"></span>
          </span>
          <span class="block text-[10px] uppercase tracking-widest text-neo-green font-semibold" data-i18n="nav_easter_hint">Klik logo = Easter Egg 🔊</span>
        </div>
      </button>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1 bg-neo-card/90 p-1.5 rounded-2xl border border-neo-border">
        <a href="#beranda" class="px-4 py-2 rounded-xl text-sm font-semibold text-gray-300 hover:text-neo-dark hover:bg-neo-green transition" data-i18n="nav_home">Beranda</a>
        <a href="#profil" class="px-4 py-2 rounded-xl text-sm font-semibold text-gray-300 hover:text-neo-dark hover:bg-neo-green transition" data-i18n="nav_about">Profil</a>
        <a href="#fitur" class="px-4 py-2 rounded-xl text-sm font-semibold text-gray-300 hover:text-neo-dark hover:bg-neo-green transition" data-i18n="nav_features">Fitur & Game</a>
        <a href="#neowall" class="px-4 py-2 rounded-xl text-sm font-semibold text-gray-300 hover:text-neo-dark hover:bg-neo-green transition" data-i18n="nav_wall">Neo-Wall</a>
      </nav>

      <!-- Right Actions: Language Switcher & Mobile Menu Button -->
      <div class="flex items-center gap-2">
        <!-- Translate Toggle ID <-> EN -->
        <button id="lang-toggle" onclick="toggleLanguage()" class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-neo-card border border-neo-green/40 hover:border-neo-bright text-xs sm:text-sm font-bold text-neo-green transition shadow-sm hover:shadow-neo-green/20 active:scale-95">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span id="lang-label">ID 🇮🇩</span>
        </button>

        <!-- Mobile Menu Toggle -->
        <button id="mobile-menu-btn" onclick="toggleMobileMenu()" class="md:hidden p-2.5 rounded-xl bg-neo-card border border-neo-border text-gray-200 hover:text-neo-green focus:outline-none" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-menu" class="hidden md:hidden px-4 pb-4 pt-2 border-t border-neo-border bg-neo-dark/95 space-y-1.5">
      <a href="#beranda" onclick="toggleMobileMenu()" class="block px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-200 hover:bg-neo-green hover:text-neo-dark transition" data-i18n="nav_home">Beranda</a>
      <a href="#profil" onclick="toggleMobileMenu()" class="block px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-200 hover:bg-neo-green hover:text-neo-dark transition" data-i18n="nav_about">Profil</a>
      <a href="#fitur" onclick="toggleMobileMenu()" class="block px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-200 hover:bg-neo-green hover:text-neo-dark transition" data-i18n="nav_features">Fitur & Game</a>
      <a href="#neowall" onclick="toggleMobileMenu()" class="block px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-200 hover:bg-neo-green hover:text-neo-dark transition" data-i18n="nav_wall">Neo-Wall</a>
    </div>
  </header>

  <main>
    <!-- ================= 1. BERANDA (HERO SECTION) ================= -->
    <section id="beranda" class="relative pt-14 pb-20 sm:pt-24 sm:pb-28 overflow-hidden">
      <!-- Ambient Glow Blobs -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[520px] h-[520px] bg-neo-green/15 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="absolute top-40 -right-24 w-72 h-72 bg-neo-dream/10 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <!-- Floating Neo Bong Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-neo-card border border-neo-green/40 text-neo-green text-xs sm:text-sm font-bold mb-8 animate-float shadow-lg shadow-neo-green/10">
          <span class="w-2.5 h-2.5 rounded-full bg-neo-bright"></span>
          <span data-i18n="hero_badge">NEO CULTURE TECHNOLOGY • FANBASE HUB</span>
        </div>

        <!-- Headline Utama -->
        <h1 class="font-display font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-tight max-w-4xl mx-auto mb-6 text-white text-glow" data-i18n="hero_headline">
          Selamat Datang di Markas NCTzen Paling Seru! Neo-Zone Resmi Dibuka 💚
        </h1>

        <!-- Sub-headline / Sapaan -->
        <p class="text-base sm:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed mb-10" data-i18n="hero_subheadline">
          Tempat nongkrong digital buat kamu yang hafal semua member, gak pernah absen streaming, dan siap halu bareng setiap hari.
        </p>

        <!-- Call to Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="#fitur" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-neo-green to-neo-bright text-neo-dark font-extrabold text-base sm:text-lg shadow-xl shadow-neo-green/25 hover:scale-105 active:scale-95 transition transform animate-pulse-glow" data-i18n="hero_cta_primary">
            Masuk ke Neo-Zone 🚀
          </a>
          <a href="#profil" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-neo-card hover:bg-white/10 text-white border border-neo-border hover:border-neo-green font-bold text-base sm:text-lg transition" data-i18n="hero_cta_secondary">
            Mulai Jelajah Sekarang ✨
          </a>
        </div>

        <!-- Mini Lightstick SVG Illustration Banner -->
        <div class="mt-14 max-w-3xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
          <div class="glass-panel rounded-2xl p-4 border-t-2 border-t-neo-u127">
            <div class="font-display font-extrabold text-xl text-neo-u127">NCT 127</div>
            <div class="text-xs text-gray-400 mt-1" data-i18n="unit_127_tag">Neo Seoul Vibes 🔥</div>
          </div>
          <div class="glass-panel rounded-2xl p-4 border-t-2 border-t-neo-dream">
            <div class="font-display font-extrabold text-xl text-neo-dream">NCT DREAM</div>
            <div class="text-xs text-gray-400 mt-1" data-i18n="unit_dream_tag">Yo Dream! 7DREAM 🩵</div>
          </div>
          <div class="glass-panel rounded-2xl p-4 border-t-2 border-t-neo-wayv">
            <div class="font-display font-extrabold text-xl text-neo-wayv">WayV</div>
            <div class="text-xs text-gray-400 mt-1" data-i18n="unit_wayv_tag">WayZenNi Power 🩷</div>
          </div>
          <div class="glass-panel rounded-2xl p-4 border-t-2 border-t-neo-wish">
            <div class="font-display font-extrabold text-xl text-neo-wish">NCT WISH</div>
            <div class="text-xs text-gray-400 mt-1" data-i18n="unit_wish_tag">Fresh & Dreamy ⭐</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 2. PROFIL / TENTANG KAMI ================= -->
    <section id="profil" class="py-16 sm:py-24 border-t border-neo-border/60 relative">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-10 items-center">
          <!-- Left Visual Card: Custom SVG Neo Bong -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="relative w-full max-w-sm aspect-square rounded-3xl bg-gradient-to-b from-neo-card to-neo-dark border border-neo-green/30 p-8 flex flex-col items-center justify-center shadow-2xl">
              <div class="absolute inset-0 bg-neo-green/5 rounded-3xl"></div>
              <!-- Custom SVG Meumwonbom (NCT Lightstick) -->
              <svg class="w-44 h-44 animate-float drop-shadow-[0_0_25px_rgba(178,232,0,0.65)]" viewBox="0 0 200 240" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Cube Head -->
                <rect x="45" y="20" width="110" height="95" rx="16" fill="#B2E800" stroke="#39FF14" stroke-width="4"/>
                <rect x="57" y="32" width="86" height="71" rx="10" fill="#0A0A0C"/>
                <text x="100" y="76" text-anchor="middle" fill="#B2E800" font-family="Space Grotesk, sans-serif" font-weight="800" font-size="30" letter-spacing="2">NCT</text>
                <!-- Neck -->
                <rect x="82" y="115" width="36" height="16" rx="4" fill="#E5E7EB"/>
                <!-- Handle -->
                <rect x="86" y="131" width="28" height="82" rx="12" fill="#FFFFFF"/>
                <circle cx="100" cy="156" r="6" fill="#B2E800"/>
                <!-- Bottom Cap -->
                <rect x="83" y="205" width="34" height="14" rx="7" fill="#B2E800"/>
              </svg>
              <p class="mt-4 font-display font-bold text-sm text-neo-green tracking-wider uppercase">Meumwonbom Ready 💚</p>
            </div>
          </div>

          <!-- Right Story Content -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-block px-3.5 py-1.5 rounded-xl bg-neo-green/10 border border-neo-green/30 text-neo-green text-xs font-bold uppercase tracking-wider" data-i18n="about_badge">
              Tentang Neo-Zone
            </div>

            <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-white leading-snug" data-i18n="about_title">
              Dari NCTzen, Oleh NCTzen, Untuk Semua Czennie di Seluruh Dunia!
            </h2>

            <!-- Kalimat Pengantar (Exact Match) -->
            <div class="p-6 rounded-2xl bg-neo-card border-l-4 border-neo-green shadow-lg">
              <p class="text-base sm:text-lg text-gray-200 leading-relaxed font-medium" data-i18n="about_intro">
                "Siapa kita? Kita adalah sekumpulan NCTzen yang kecanduan suara high note Taeil, senyuman Haechan, dan interaksi random Mark & Johnny di 24h Relay Cam."
              </p>
            </div>

            <!-- Misi Website (Exact Match) -->
            <div class="p-6 rounded-2xl bg-gradient-to-r from-neo-green/15 to-transparent border border-neo-green/30">
              <div class="flex items-start gap-3.5">
                <span class="text-2xl">🎯</span>
                <p class="text-base sm:text-lg text-white font-semibold leading-relaxed" data-i18n="about_mission">
                  Misi kita cuma satu: Bikin hari-hari kamu lebih berwarna dengan update NCT 24/7 tanpa bikin bosan!
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 3. FITUR & MENU INTERAKTIF ================= -->
    <section id="fitur" class="py-16 sm:py-24 border-t border-neo-border/60 bg-neo-card/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="inline-block px-3.5 py-1.5 rounded-xl bg-neo-green/10 border border-neo-green/30 text-neo-green text-xs font-bold uppercase tracking-wider mb-3" data-i18n="features_badge">
            Zona Interaktif
          </span>
          <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white" data-i18n="features_title">
            Jelajahi Wahana Seru Neo-Zone
          </h2>
        </div>

        <!-- 3 Feature Navigation Cards (Interactive Tabs) -->
        <div class="grid md:grid-cols-3 gap-5 mb-10">
          <!-- Tab 1: Jadwal -->
          <button onclick="switchFeatureTab('jadwal')" id="tab-btn-jadwal" class="feature-tab-btn text-left p-6 rounded-3xl bg-neo-card border-2 border-neo-green shadow-lg shadow-neo-green/10 transition transform hover:-translate-y-1">
            <div class="flex items-center justify-between mb-3">
              <span class="text-3xl">📅</span>
              <span class="px-2.5 py-1 rounded-lg bg-neo-green text-neo-dark text-xs font-extrabold" data-i18n="tab_schedule_tag">TRACKER</span>
            </div>
            <h3 class="font-display font-extrabold text-xl text-white mb-2" data-i18n="tab_schedule_title">Menu Jadwal (Comeback Tracker)</h3>
            <p class="text-sm text-gray-300 leading-relaxed" data-i18n="tab_schedule_desc">
              Jadwal Halal & Haram Terlewat! Jangan sampai ketinggalan teaser, comeback, atau konser oppa-oppa kesayangan kita.
            </p>
          </button>

          <!-- Tab 2: Galeri -->
          <button onclick="switchFeatureTab('galeri')" id="tab-btn-galeri" class="feature-tab-btn text-left p-6 rounded-3xl bg-neo-card border border-neo-border hover:border-neo-green/60 transition transform hover:-translate-y-1">
            <div class="flex items-center justify-between mb-3">
              <span class="text-3xl">📸</span>
              <span class="px-2.5 py-1 rounded-lg bg-white/10 text-neo-green text-xs font-extrabold" data-i18n="tab_gallery_tag">VISUAL</span>
            </div>
            <h3 class="font-display font-extrabold text-xl text-white mb-2" data-i18n="tab_gallery_title">Menu Galeri (Neo-Gallery)</h3>
            <p class="text-sm text-gray-300 leading-relaxed" data-i18n="tab_gallery_desc">
              Kumpulan visual berbahaya yang siap bikin kamu oleng ke semua member (OT21/OT23/OT26 approved!).
            </p>
          </button>

          <!-- Tab 3: Mini Games -->
          <button onclick="switchFeatureTab('game')" id="tab-btn-game" class="feature-tab-btn text-left p-6 rounded-3xl bg-neo-card border border-neo-border hover:border-neo-green/60 transition transform hover:-translate-y-1">
            <div class="flex items-center justify-between mb-3">
              <span class="text-3xl">🎮</span>
              <span class="px-2.5 py-1 rounded-lg bg-neo-bright/20 text-neo-bright text-xs font-extrabold animate-pulse" data-i18n="tab_game_tag">PLAY NOW</span>
            </div>
            <h3 class="font-display font-extrabold text-xl text-white mb-2" data-i18n="tab_game_title">Menu Kuis / Mini Games</h3>
            <p class="text-sm text-gray-300 leading-relaxed" data-i18n="tab_game_desc">
              Seberapa NCTzen Kamu? Tes seberapa akurat instingmu buat nebak suara member cuma dari tawa mereka!
            </p>
          </button>
        </div>

        <!-- ========== PANEL A: COMEBACK TRACKER (JADWAL) ========== -->
        <div id="panel-jadwal" class="feature-panel glass-panel rounded-3xl p-6 sm:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-neo-border">
            <div>
              <h3 class="font-display font-extrabold text-2xl text-neo-green" data-i18n="sched_header">📅 Jadwal Halal & Haram Terlewat!</h3>
              <p class="text-sm text-gray-400 mt-1" data-i18n="sched_sub">Klik tombol lonceng untuk memasang pengingat agar tidak telat war tiket atau streaming!</p>
            </div>
            <!-- Filter Unit -->
            <div class="flex flex-wrap gap-2">
              <button onclick="filterSchedule('ALL')" class="sched-filter active px-3.5 py-1.5 rounded-xl text-xs font-bold bg-neo-green text-neo-dark">ALL UNITS</button>
              <button onclick="filterSchedule('NCT 127')" class="sched-filter px-3.5 py-1.5 rounded-xl text-xs font-bold bg-neo-dark border border-neo-u127/50 text-neo-u127 hover:bg-neo-u127 hover:text-white transition">NCT 127</button>
              <button onclick="filterSchedule('NCT DREAM')" class="sched-filter px-3.5 py-1.5 rounded-xl text-xs font-bold bg-neo-dark border border-neo-dream/50 text-neo-dream hover:bg-neo-dream hover:text-neo-dark transition">NCT DREAM</button>
              <button onclick="filterSchedule('WayV')" class="sched-filter px-3.5 py-1.5 rounded-xl text-xs font-bold bg-neo-dark border border-neo-wayv/50 text-neo-wayv hover:bg-neo-wayv hover:text-white transition">WayV</button>
              <button onclick="filterSchedule('NCT WISH')" class="sched-filter px-3.5 py-1.5 rounded-xl text-xs font-bold bg-neo-dark border border-neo-wish/50 text-neo-wish hover:bg-neo-wish hover:text-white transition">NCT WISH</button>
            </div>
          </div>

          <div id="schedule-list" class="mt-6 grid sm:grid-cols-2 gap-4">
            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- ========== PANEL B: NEO-GALLERY ========== -->
        <div id="panel-galeri" class="feature-panel hidden glass-panel rounded-3xl p-6 sm:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-neo-border">
            <div>
              <h3 class="font-display font-extrabold text-2xl text-neo-green" data-i18n="gal_header">📸 Neo-Gallery: Zona Rawan Oleng</h3>
              <p class="text-sm text-gray-400 mt-1" data-i18n="gal_sub">Klik kartu era untuk melihat detail konsep dan kirim reaksi hati!</p>
            </div>
            <span class="px-3.5 py-1.5 rounded-xl bg-neo-green/10 border border-neo-green/30 text-neo-green text-xs font-bold">OT21 / OT23 / OT26 APPROVED 💚</span>
          </div>

          <div id="gallery-grid" class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- ========== PANEL C: MINI GAMES ("SEBERAPA NCTZEN KAMU?") ========== -->
        <div id="panel-game" class="feature-panel hidden glass-panel rounded-3xl p-6 sm:p-8">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-neo-border">
            <div>
              <h3 class="font-display font-extrabold text-2xl text-neo-green" data-i18n="game_header">🎮 Seberapa NCTzen Kamu?</h3>
              <p class="text-sm text-gray-400 mt-1" data-i18n="game_sub">Pilih mode permainan di bawah untuk menguji insting Czennie kamu!</p>
            </div>
            <!-- Game Mode Switcher -->
            <div class="flex gap-2 bg-neo-dark p-1.5 rounded-2xl border border-neo-border">
              <button onclick="switchGameMode('quiz')" id="gmode-quiz" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-neo-green text-neo-dark transition" data-i18n="game_mode_quiz">
