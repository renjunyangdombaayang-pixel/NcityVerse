            <p class="text-sm text-gray-200 leading-relaxed break-words">"${escapeHTML(post.message)}"</p>
          </div>
          <div class="flex items-center justify-between pt-3 border-t border-neo-border/60 text-xs text-gray-400">
            <span>${post.time}</span>
            <button onclick="likeWallPost(${post.id})" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-neo-dark hover:bg-neo-green/20 text-neo-green font-bold transition active:scale-90">
              <span>💚</span> <span>${post.likes}</span>
            </button>
          </div>
        </div>
      `).join('');
    }

    function submitWallMessage(e) {
      e.preventDefault();
      const nameInput = document.getElementById('wall-name');
      const unitInput = document.getElementById('wall-unit');
      const msgInput = document.getElementById('wall-message');

      const newPost = {
        id: Date.now(),
        name: nameInput.value.trim(),
        unit: unitInput.value,
        message: msgInput.value.trim(),
        likes: 1,
        time: currentLang === 'id' ? 'Baru saja' : 'Just now'
      };

      const posts = getWallPosts();
      posts.unshift(newPost);
      saveWallPosts(posts);
      renderWallPosts();

      nameInput.value = '';
      msgInput.value = '';
      playNeoFanfare([523.25, 659.25, 1046.5]);
      spawnConfetti();
      showToast(currentLang === 'id' ? '💌 Teriakan hatimu berhasil ditempel di Neo-Wall!' : '💌 Your heart scream has been pinned to Neo-Wall!');
    }

    function likeWallPost(id) {
      const posts = getWallPosts();
      const target = posts.find(p => p.id === id);
      if (target) {
        target.likes += 1;
        saveWallPosts(posts);
        renderWallPosts();
        playNeoFanfare([880]);
      }
    }

    function escapeHTML(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // ==========================================
    // INITIALIZE ON LOAD
    // ==========================================
    window.addEventListener('DOMContentLoaded', () => {
      renderSchedule('ALL');
      renderGallery();
      loadQuizQuestion();
      initCatchGrid();
      renderWallPosts();
    });
