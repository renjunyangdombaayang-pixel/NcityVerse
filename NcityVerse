    function getWallPosts() {
      try {
        const saved = localStorage.getItem('neozone_wall_posts');
        return saved ? JSON.parse(saved) : defaultWallPosts;
      } catch (e) {
        return defaultWallPosts;
      }
    }

    function saveWallPosts(posts) {
      try {
        localStorage.setItem('neozone_wall_posts', JSON.stringify(posts));
      } catch (e) {
        console.warn('LocalStorage unavailable');
      }
    }

    function renderWallPosts() {
      const posts = getWallPosts();
      const container = document.getElementById('wall-posts');
      container.innerHTML = posts.map(post => `
        <div class="p-5 rounded-3xl bg-neo-card border border-neo-border hover:border-neo-green/50 transition flex flex-col justify-between gap-4 shadow-md">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2.5">
              <span class="font-display font-bold text-sm text-white truncate">${escapeHTML(post.name)}</span>
              <span class="px-2.5 py-0.5 rounded-lg bg-neo-green/15 text-neo-green text-[11px] font-extrabold shrink-0">${escapeHTML(post.unit)}</span>
