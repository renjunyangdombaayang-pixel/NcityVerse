        </button>
      `).join('');
    }

    function selectQuizAnswer(selectedIdx) {
      if (quizAnswered) return;
      quizAnswered = true;
      const q = quizQuestions[currentQIndex];
      const buttons = document.querySelectorAll('.quiz-opt-btn');
      const feedback = document.getElementById('quiz-feedback');
      feedback.classList.remove('hidden');

      if (selectedIdx === q.answer) {
        quizScore += 20;
        document.getElementById('quiz-score').textContent = quizScore;
        buttons[selectedIdx].classList.add('bg-neo-green', 'text-neo-dark', 'border-neo-green');
        feedback.className = 'mt-5 p-4 rounded-2xl text-sm font-bold bg-neo-green/20 border border-neo-green text-neo-green';
