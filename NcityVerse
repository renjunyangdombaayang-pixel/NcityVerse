    // --- GAME 2: CATCH THE NEO BONG ---
    let catchScore = 0;
    let catchTime = 20;
    let catchInterval = null;
    let spawnInterval = null;
    let catchRunning = false;

    function initCatchGrid() {
      const grid = document.getElementById('catch-grid');
      grid.innerHTML = '';
      for (let i = 0; i < 9; i++) {
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.id = `catch-cell-${i}`;
        cell.className = 'rounded-2xl bg-neo-dark border border-neo-border flex items-center justify-center text-3xl sm:text-4xl transition active:scale-90 select-none';
        cell.innerHTML = '<span class="opacity-20 text-xl">•</span>';
        grid.appendChild(cell);
      }
    }

    function startCatchGame() {
      if (catchRunning) return;
      catchRunning = true;
      catchScore = 0;
      catchTime = 20;
      document.getElementById('catch-score').textContent = catchScore;
      document.getElementById('catch-timer').textContent = catchTime;
      document.getElementById('catch-start-btn').disabled = true;
      document.getElementById('catch-start-btn').classList.add('opacity-50');
      initCatchGrid();

      catchInterval = setInterval(() => {
        catchTime--;
        document.getElementById('catch-timer').textContent = catchTime;
        if (catchTime <= 0) {
          endCatchGame();
        }
      }, 1000);

      spawnInterval = setInterval(() => {
        if (!catchRunning) return;
        for (let i = 0; i < 9; i++) {
          const c = document.getElementById(`catch-cell-${i}`);
          c.innerHTML = '<span class="opacity-20 text-xl">•</span>';
          c.className = 'rounded-2xl bg-neo-dark border border-neo-border flex items-center justify-center text-3xl sm:text-4xl transition active:scale-90 select-none';
          c.onclick = null;
        }

        const randIdx = Math.floor(Math.random() * 9);
        const isBomb = Math.random() < 0.22;
        const target = document.getElementById(`catch-cell-${randIdx}`);

        if (isBomb) {
          target.innerHTML = '💣';
          target.className = 'rounded-2xl bg-red-500/20 border-2 border-red-500 flex items-center justify-center text-3xl sm:text-4xl transition active:scale-90 cursor-pointer';
          target.onclick = () => {
            catchScore = Math.max(0, catchScore - 15);
            document.getElementById('catch-score').textContent = catchScore;
            playNeoFanfare([180, 140]);
            target.innerHTML = '💥';
            target.onclick = null;
          };
        } else {
          target.innerHTML = '💚';
          target.className = 'rounded-2xl bg-neo-green/25 border-2 border-neo-bright shadow-lg shadow-neo-green/30 flex items-center justify-center text-3xl sm:text-4xl transition active:scale-90 cursor-pointer';
          target.onclick = () => {
            catchScore += 10;
            document.getElementById('catch-score').textContent = catchScore;
            playNeoFanfare([784, 1046]);
            target.innerHTML = '✨';
            target.onclick = null;
          };
        }
      }, 720);
    }

    function endCatchGame() {
      catchRunning = false;
      clearInterval(catchInterval);
      clearInterval(spawnInterval);
      initCatchGrid();
      const btn = document.getElementById('catch-start-btn');
      btn.disabled = false;
      btn.classList.remove('opacity-50');
      spawnConfetti();
      showToast(currentLang === 'id'
        ? `🎉 Waktu habis! Kamu menangkap ${catchScore} poin Neo Bong!`
        : `🎉 Time's up! You caught ${catchScore} Neo Bong points!`);
